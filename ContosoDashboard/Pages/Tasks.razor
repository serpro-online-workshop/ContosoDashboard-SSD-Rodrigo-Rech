@page "/tasks"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject ITaskService TaskService
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Tasks - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>My Tasks</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateTaskModal">
                <i class="bi bi-plus-circle"></i> New Task
            </button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Attach a document to a task</h2>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="task-document-task">Task</label>
                    <select id="task-document-task" class="form-select" @bind="taskUploadId">
                        <option value="">Select a task</option>
                        @if (tasks != null)
                        {
                            @foreach (var task in tasks)
                            {
                                <option value="@task.TaskId">@task.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="task-document-title">Title</label>
                    <input id="task-document-title" class="form-control" @bind="taskUploadTitle" maxlength="255" placeholder="Defaults to the file name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="task-document-category">Category</label>
                    <select id="task-document-category" class="form-select" @bind="taskUploadCategory">
                        @foreach (var category in DocumentCategories.All)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="task-document-file">File</label>
                    <InputFile id="task-document-file" OnChange="SelectTaskFile" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="UploadTaskDocument" disabled="@(taskUploadId == null || taskUploadFile == null || isTaskUploading)">
                        @if (isTaskUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Upload
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(taskUploadMessage))
            {
                <div class="alert alert-info mt-3 mb-0">@taskUploadMessage</div>
            }
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label>Status</label>
            <select class="form-select" @bind="filterStatus">
                <option value="">All</option>
                <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                <option value="@Models.TaskStatus.InProgress">In Progress</option>
                <option value="@Models.TaskStatus.Completed">Completed</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>Priority</label>
            <select class="form-select" @bind="filterPriority">
                <option value="">All</option>
                <option value="@TaskPriority.Low">Low</option>
                <option value="@TaskPriority.Medium">Medium</option>
                <option value="@TaskPriority.High">High</option>
                <option value="@TaskPriority.Critical">Critical</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-secondary d-block w-100" @onclick="ApplyFilters">
                Apply Filters
            </button>
        </div>
    </div>

    <!-- Tasks List -->
    @if (tasks == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!tasks.Any())
    {
        <div class="alert alert-info">No tasks found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Project</th>
                        <th>Documents</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>
                                <strong>@task.Title</strong>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <br />
                                    <small class="text-muted">@task.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(task.Priority)">
                                    @task.Priority
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" 
                                        value="@task.Status" 
                                        @onchange="@(e => UpdateTaskStatus(task.TaskId, Enum.Parse<Models.TaskStatus>(e.Value?.ToString() ?? "NotStarted")))">
                                    <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                                    <option value="@Models.TaskStatus.InProgress">In Progress</option>
                                    <option value="@Models.TaskStatus.Completed">Completed</option>
                                </select>
                            </td>
                            <td>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = task.DueDate.Value < DateTime.UtcNow && task.Status != Models.TaskStatus.Completed;
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @task.DueDate.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No due date</span>
                                }
                            </td>
                            <td>
                                @if (task.Project != null)
                                {
                                    <a href="/projects/@task.ProjectId">@task.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (taskDocuments.TryGetValue(task.TaskId, out var documents) && documents.Count > 0)
                                {
                                    @foreach (var document in documents)
                                    {
                                        <a class="d-block small" href="/documents/@document.DocumentId/download">@document.Title</a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewTaskDetails(task.TaskId)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<TaskItem>? tasks;
    private string filterStatus = "";
    private string filterPriority = "";
    private Dictionary<int, List<DocumentSummary>> taskDocuments = new();
    private int? taskUploadId;
    private IBrowserFile? taskUploadFile;
    private string taskUploadTitle = string.Empty;
    private string taskUploadCategory = DocumentCategories.ProjectDocuments;
    private string taskUploadMessage = string.Empty;
    private bool isTaskUploading;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            await LoadTasks();
        }
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetUserTasksAsync(currentUserId);
        await LoadTaskDocuments();
    }

    private async Task ApplyFilters()
    {
        Models.TaskStatus? status = string.IsNullOrEmpty(filterStatus) ? null : Enum.Parse<Models.TaskStatus>(filterStatus);
        TaskPriority? priority = string.IsNullOrEmpty(filterPriority) ? null : Enum.Parse<TaskPriority>(filterPriority);

        tasks = await TaskService.GetFilteredTasksAsync(currentUserId, status, priority, null);
        await LoadTaskDocuments();
    }

    private async Task LoadTaskDocuments()
    {
        taskDocuments = new Dictionary<int, List<DocumentSummary>>();
        if (tasks == null)
        {
            return;
        }

        foreach (var task in tasks)
        {
            var page = await DocumentService.ListVisibleAsync(currentUserId, new DocumentQueryOptions
            {
                TaskId = task.TaskId,
                PageNumber = 1,
                PageSize = 10,
                SortBy = DocumentSortField.UploadedAt,
                Descending = true
            });
            taskDocuments[task.TaskId] = page.Items.ToList();
        }
    }

    private void SelectTaskFile(InputFileChangeEventArgs args)
    {
        taskUploadFile = args.FileCount == 0 ? null : args.File;
    }

    private async Task UploadTaskDocument()
    {
        var task = tasks?.SingleOrDefault(item => item.TaskId == taskUploadId);
        if (task == null || taskUploadFile == null)
        {
            taskUploadMessage = "Select a task and file before uploading.";
            return;
        }

        var file = taskUploadFile;
        isTaskUploading = true;
        taskUploadMessage = string.Empty;
        try
        {
            var result = (await DocumentService.UploadAsync(currentUserId, new DocumentUploadRequest
            {
                SharedMetadata = new DocumentMetadataInput
                {
                    Title = string.IsNullOrWhiteSpace(taskUploadTitle) ? Path.GetFileNameWithoutExtension(file.Name) : taskUploadTitle,
                    Category = taskUploadCategory,
                    ProjectId = task.ProjectId,
                    TaskId = task.TaskId
                },
                Files = new[]
                {
                    new DocumentUploadItem
                    {
                        OriginalFileName = file.Name,
                        ContentType = file.ContentType,
                        Length = file.Size,
                        OpenReadAsync = cancellationToken => Task.FromResult<Stream>(file.OpenReadStream(DocumentStorageLimits.MaxFileSizeBytes, cancellationToken))
                    }
                }
            })).Single();
            taskUploadMessage = result.Message;
            if (result.Succeeded)
            {
                taskUploadFile = null;
                taskUploadTitle = string.Empty;
                await LoadTaskDocuments();
            }
        }
        finally
        {
            isTaskUploading = false;
        }
    }

    private async Task UpdateTaskStatus(int taskId, Models.TaskStatus newStatus)
    {
        if (currentUserId > 0)
        {
            await TaskService.UpdateTaskStatusAsync(taskId, currentUserId, newStatus);
            await LoadTasks();
        }
    }

    private void ShowCreateTaskModal()
    {
        // TODO: Implement modal dialog for creating tasks
    }

    private void ViewTaskDetails(int taskId)
    {
        // TODO: Navigate to task details or show modal
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Critical => "danger",
            TaskPriority.High => "warning",
            TaskPriority.Medium => "info",
            TaskPriority.Low => "secondary",
            _ => "secondary"
        };
    }
}
