@page "/documents/shared"
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Shared With Me - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Shared with Me</h1>
            <p class="text-muted mb-0">Documents explicitly shared with your account or department.</p>
        </div>
        <NavLink class="btn btn-outline-secondary" href="/documents">My Documents</NavLink>
    </div>

    @if (documents == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (documents.Count == 0)
    {
        <div class="alert alert-info">No documents have been shared with you.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var document in documents)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5">@document.Title</h2>
                            <p class="text-muted small mb-2">@document.Category · @document.OriginalFileName</p>
                            @if (!string.IsNullOrWhiteSpace(document.Description))
                            {
                                <p class="mb-2">@document.Description</p>
                            }
                            <p class="small text-muted mb-3">
                                Uploaded by @document.UploaderName on @document.UploadedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")
                            </p>
                            <div class="mt-auto">
                                @if (DocumentFileTypes.IsPreviewable(document.FileType))
                                {
                                    <a class="btn btn-sm btn-outline-primary me-1" href="/documents/@document.DocumentId/preview" target="_blank" rel="noopener">Preview</a>
                                }
                                <a class="btn btn-sm btn-outline-secondary" href="/documents/@document.DocumentId/download">Download</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DocumentSummary>? documents;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claim = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim != null)
        {
            int.TryParse(claim.Value, out currentUserId);
        }

        documents = (await DocumentService.GetSharedWithMeAsync(currentUserId)).ToList();
    }
}
