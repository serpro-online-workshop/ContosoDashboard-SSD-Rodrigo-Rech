@page "/documents/reports"
@attribute [Authorize(Roles = "Administrator")]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Document Reports - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Document activity report</h1>
            <p class="text-muted mb-0">Review document activity grouped by action, file type, and uploader.</p>
        </div>
        <NavLink class="btn btn-outline-secondary" href="/documents">Documents</NavLink>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label" for="report-from">From (UTC)</label>
                    <input id="report-from" class="form-control" type="date" @bind="fromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="report-to">To (UTC)</label>
                    <input id="report-to" class="form-control" type="date" @bind="toDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="report-action">Action</label>
                    <select id="report-action" class="form-select" @bind="actionType">
                        <option value="">All actions</option>
                        <option value="Upload">Uploaded</option>
                        <option value="Download">Downloaded</option>
                        <option value="Preview">Previewed</option>
                        <option value="Replace">Replaced</option>
                        <option value="Delete">Deleted</option>
                        <option value="Share">Shared</option>
                        <option value="AccessReview">Access reviewed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="report-file-type">File type</label>
                    <input id="report-file-type" class="form-control" @bind="fileType" placeholder="application/pdf" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="report-uploader">Uploader ID</label>
                    <input id="report-uploader" class="form-control" type="number" @bind="uploaderId" />
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" @onclick="LoadReport">Run report</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-warning mt-3 mb-0">@message</div>
            }
        </div>
    </div>

    @if (report == null)
    {
        <p><em>Choose a date range to run the report.</em></p>
    }
    else if (report.Rows.Count == 0)
    {
        <div class="alert alert-info">No matching activity was found.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">@report.TotalActivities activities</h2>
            <small class="text-muted">@report.FromUtc.ToString("yyyy-MM-dd") to @report.ToUtc.ToString("yyyy-MM-dd") UTC</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>File type</th>
                        <th>Uploader</th>
                        <th class="text-end">Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in report.Rows)
                    {
                        <tr>
                            <td>@row.ActionType</td>
                            <td>@(string.IsNullOrWhiteSpace(row.FileType) ? "Unknown" : row.FileType)</td>
                            <td>@row.Uploader</td>
                            <td class="text-end">@row.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private DocumentActivityReport? report;
    private DateTime? fromDate = DateTime.UtcNow.Date.AddDays(-30);
    private DateTime? toDate = DateTime.UtcNow.Date;
    private string actionType = string.Empty;
    private string fileType = string.Empty;
    private int? uploaderId;
    private string message = string.Empty;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claim = authenticationState.User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim != null)
        {
            int.TryParse(claim.Value, out currentUserId);
        }

        await LoadReport();
    }

    private async Task LoadReport()
    {
        message = string.Empty;
        if (!fromDate.HasValue || !toDate.HasValue)
        {
            message = "Choose both dates before running the report.";
            return;
        }

        var fromUtc = DateTime.SpecifyKind(fromDate.Value.Date, DateTimeKind.Utc);
        var toUtc = DateTime.SpecifyKind(toDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);
        if (fromUtc > toUtc)
        {
            message = "The report date range is reversed.";
            return;
        }

        report = await DocumentService.GetActivityReportAsync(currentUserId, new DocumentActivityReportOptions
        {
            FromUtc = fromUtc,
            ToUtc = toUtc,
            ActionType = string.IsNullOrWhiteSpace(actionType) ? null : actionType,
            FileType = string.IsNullOrWhiteSpace(fileType) ? null : fileType,
            UploaderId = uploaderId
        });

        if (report.Rows.Count == 0 && report.TotalActivities == 0)
        {
            message = "No activity was found, or your account is not authorized for this report.";
        }
    }
}
